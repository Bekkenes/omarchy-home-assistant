# Home Assistant MQTT broker.
# Sharing the broker with Zigbee2MQTT is fine: topics do not overlap
# (zigbee2mqtt/# vs workstation/# vs homeassistant/#).
MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USER=workstation
MQTT_PASS=CHANGE_ME
# Only needed if HA's MQTT discovery prefix is not "homeassistant":
# MQTT_DISCOVERY_PREFIX=homeassistant
